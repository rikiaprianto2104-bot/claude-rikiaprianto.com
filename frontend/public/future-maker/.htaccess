# ============================================================================
#  .htaccess KHUSUS folder /future-maker/ — materi kelas (satu file per pertemuan).
#
#  KENAPA ADA FILE TERPISAH DI SINI?
#  Tiap materi adalah SATU file HTML mandiri: gambar, font, dan model Pixi
#  tertanam di dalamnya sebagai data base64, dan seluruh skripnya inline supaya
#  bisa dibuka dari flashdisk kalau WiFi kelas mati. script-src di root sudah
#  tidak memuat 'unsafe-inline', jadi tanpa pengecualian ini halamannya mati
#  total di browser. Pola dan alasannya sama dengan projects/.htaccess.
#
#  Slide "Kenalan sama Pixi" memuat halaman /pixi/ di dalam bingkai, jadi dua
#  hal ikut dibuka di sini:
#    - frame-src 'self' (sudah ada di CSP root) supaya bingkainya boleh dimuat.
#    - microphone=(self), karena izin mikrofon di dalam bingkai mengikuti
#      halaman INDUKNYA. Root memakai microphone=() yang mematikan mikrofon
#      untuk seluruh situs, jadi tanpa baris ini tombol "Mulai ngobrol" di
#      dalam bingkai mati walaupun /pixi/ sendiri sudah mengizinkannya.
#  Halaman ini tidak memegang sesi dan tidak menampilkan data pengguna, dan
#  kamera tetap mati seperti di root.
#
#  KALAU CSP DI ROOT DIUBAH, samakan juga baris CSP di bawah agar tidak
#  menyimpang — sama seperti catatan di projects/.htaccess dan pixi/.htaccess.
# ============================================================================

<IfModule mod_headers.c>

  # Beda dari CSP root pada dua hal: script-src memuat 'unsafe-inline', dan
  # connect-src memuat blob:.
  #
  # blob: dipakai Pixi 3D yang menari di slide terakhir. GLTFLoader membongkar
  # tekstur dan buffer di dalam berkas .glb menjadi URL blob:, lalu mengambilnya
  # kembali lewat fetch. Tanpa blob: di connect-src, modelnya berhenti di tengah
  # jalan dan Pixi tidak pernah muncul. Alasan dan pengecualian yang sama persis
  # sudah ada di pixi/.htaccess - kalau yang satu diubah, ubah keduanya.
  # Sama persis dengan Permissions-Policy root KECUALI microphone=(self),
  # sama seperti pixi/.htaccess. Alasannya ada di catatan di atas.
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=(), interest-cohort=(), fullscreen=(self), gamepad=(self), autoplay=(self)"

  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://www.facebook.com; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://us-assets.i.posthog.com https://us.i.posthog.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.sheetjs.com https://unpkg.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' https://www.facebook.com; manifest-src 'self'; connect-src 'self' blob: https://us.i.posthog.com https://us-assets.i.posthog.com https://*.i.posthog.com https://www.facebook.com https://connect.facebook.net https://0.peerjs.com wss://0.peerjs.com https://*.firebaseio.com wss://*.firebaseio.com; upgrade-insecure-requests"

</IfModule>

# Alamat materi yang ditulis tangan sering memakai huruf besar, misalnya
# "/future-maker/Pertemuan-3/". Server Linux membedakan besar-kecil huruf,
# jadi folder itu tidak ketemu, lalu aturan tangkap-semua milik React yang
# melayaninya - dan React tidak punya rute untuk alamat itu, sehingga yang
# terlihat halaman PUTIH KOSONG, bukan pesan "tidak ditemukan". Sulit ditebak
# penyebabnya dari layar.
#
# Di sini ejaan apa pun diarahkan ke folder yang benar. Syarat di bawah
# memastikan alamat yang SUDAH benar (huruf kecil dan berakhir garis miring)
# dilewati, supaya tidak berputar-putar mengarahkan dirinya sendiri.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # PENTING. Menyalakan RewriteEngine di sini membuat aturan mod_rewrite milik
  # .htaccess induk TIDAK lagi berlaku untuk folder ini - mod_rewrite memang
  # tidak mewariskan aturan ke bawah. Salah satu yang hilang adalah aturan yang
  # menyajikan halaman React untuk alamat "/future-maker/" itu sendiri. Tanpa
  # penggantinya, Apache mencari berkas indeks di folder ini, tidak menemukan
  # apa pun, dan menjawab 403 Forbidden. Jadi aturan itu ditulis ulang di sini.
  RewriteRule ^$ /index.html [L]

  # Alamat materi yang ditulis tangan sering memakai huruf besar, misalnya
  # "/future-maker/Pertemuan-3/". Server Linux membedakan besar-kecil huruf,
  # jadi folder itu tidak ketemu dan yang terlihat halaman putih kosong.
  # Syarat di bawah melewatkan alamat yang SUDAH benar supaya tidak berputar.
  RewriteCond %{REQUEST_URI} !^/future-maker/pertemuan-[0-9]+/$
  RewriteRule ^pertemuan-([0-9]+)/?$ /future-maker/pertemuan-$1/ [R=302,L,NC]
</IfModule>
