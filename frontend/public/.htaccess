# ============================================================================
#  .htaccess — konfigurasi Apache/LiteSpeed untuk rikiaprianto.com
#  File ini ikut ter-upload ke public_html oleh deploy.sh & GitHub Actions.
#  Bagian 1-2 = opsi dasar & routing SPA, bagian 3-4 = pengerasan keamanan.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Opsi dasar
# ---------------------------------------------------------------------------
# -MultiViews : Apache tidak menebak-nebak nama file (mis. /projects -> projects.html).
# -Indexes    : matikan daftar isi folder kalau folder tidak punya index
#               (tanpa ini, /projects/thumbs/ bisa membocorkan seluruh nama file).
Options -MultiViews -Indexes

# Folder fisik /projects/ (berisi file .html aplikasi & game) punya nama yang sama
# dengan route React /projects. Tanpa baris ini Apache mengalihkan /projects ke
# /projects/ lalu menolaknya dengan 403 karena folder itu tidak punya index.
DirectorySlash Off

# ---------------------------------------------------------------------------
# 2. Rewrite: HTTPS, blokir file rahasia, lalu routing SPA
#    URUTAN PENTING — aturan blokir harus di ATAS catch-all SPA. Kalau dibalik,
#    permintaan ke /.env akan tertangkap catch-all dan dibalas index.html
#    (bukan 403), sehingga aturan blokirnya tidak pernah dievaluasi.
# ---------------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# -- 2a. Paksa HTTPS --------------------------------------------------------
# Hostinger sudah melakukan ini, baris berikut jaring pengaman kalau suatu saat
# konfigurasi panel berubah.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# -- 2b. Tutup akses ke file yang tidak boleh dibaca publik -----------------
# Semua path yang mengandung komponen diawali titik: .env, .git/, .htaccess,
# .htpasswd, .DS_Store, dst. /.well-known/ dikecualikan (dipakai Let's Encrypt).
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# File konfigurasi / source yang kadang ikut ter-upload tanpa sengaja.
# Memakai RewriteRule (bukan <FilesMatch>+Require) supaya portabel di semua
# versi Apache/LiteSpeed dan tidak berisiko memicu error 500.
RewriteRule (?i)\.(env|ini|log|sh|bak|old|orig|swp|sql|db|yml|yaml|lock|map)$ - [F,L]
RewriteRule (?i)(^|/)(package(-lock)?\.json|yarn\.lock|composer\.(json|lock)|Dockerfile|deploy\.sh|server\.py|requirements\.txt)$ - [F,L]

# -- 2c. Routing SPA --------------------------------------------------------
# Route React /projects selalu dilayani SPA, bukan folder fisiknya.
# File di dalamnya (mis. /projects/distribusi-app.html) tidak cocok pola ini
# sehingga tetap dilayani langsung.
RewriteRule ^projects/?$ /index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# ---------------------------------------------------------------------------
# 3. Header keamanan
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>

  # -- HSTS -----------------------------------------------------------------
  # Browser wajib memakai HTTPS untuk domain ini selama 1 tahun. Mencegah
  # serangan "SSL strip" di WiFi publik.
  # Catatan: TANPA includeSubDomains, supaya subdomain yang mungkin belum
  # ber-HTTPS (mis. panel/webmail) tidak ikut terkunci. Kalau semua subdomain
  # sudah pasti HTTPS, boleh diubah jadi:
  #   "max-age=31536000; includeSubDomains"
  Header always set Strict-Transport-Security "max-age=31536000"

  # -- Anti clickjacking ----------------------------------------------------
  # Situs ini tidak boleh di-iframe oleh domain lain (mencegah orang membungkus
  # halaman pendaftaran dengan tombol palsu di atasnya).
  Header always set X-Frame-Options "SAMEORIGIN"

  # -- Anti MIME sniffing ---------------------------------------------------
  # Browser harus menuruti Content-Type; file .png berisi HTML tidak akan
  # dieksekusi sebagai HTML.
  Header always set X-Content-Type-Options "nosniff"

  # -- Kebocoran URL ke pihak ketiga ---------------------------------------
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # -- Matikan API perangkat yang tidak dipakai ----------------------------
  # fullscreen/gamepad tetap diizinkan karena dipakai game di /projects/.
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), fullscreen=(self), gamepad=(self), autoplay=(self)"

  # -- Isolasi tab ----------------------------------------------------------
  # Popup WhatsApp/LinkedIn tetap jalan, tapi tidak bisa mengendalikan tab ini.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-site"

  # -- Content Security Policy ---------------------------------------------
  # Daftar putih sumber yang boleh dimuat. Menahan sebagian besar serangan
  # injeksi: skrip dari domain asing akan ditolak browser.
  #
  # script-src TIDAK lagi memuat 'unsafe-inline': seluruh skrip sudah pindah ke
  # public/analytics.js sehingga index.html nol skrip inline. Dampaknya besar —
  # skrip apa pun yang berhasil disuntikkan ke HTML akan DITOLAK browser, bukan
  # dijalankan. Konsekuensinya: menambah satu saja tag script inline baru di
  # index.html akan membuatnya diblokir diam-diam di produksi.
  #
  # Folder /projects/ punya .htaccess sendiri dengan script-src lebih longgar,
  # karena 22 halaman game di sana ditulis dengan skrip inline. Kalau daftar
  # domain di bawah diubah, samakan juga di frontend/public/projects/.htaccess.
  #
  # Kalau menambah layanan pihak ketiga baru (chat widget, analytics lain),
  # domainnya HARUS didaftarkan di sini atau resource-nya akan diblokir.
  #
  # www.facebook.com muncul di form-action DAN frame-src karena Meta Pixel
  # mengirim event lewat <form> POST di dalam <iframe> tersembunyi ke
  # facebook.com/tr/ saat transport lain tidak tersedia. Tanpa dua izin itu
  # pixel berhenti melapor tanpa error yang kelihatan di halaman.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://www.facebook.com; script-src 'self' https://connect.facebook.net https://us-assets.i.posthog.com https://us.i.posthog.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.sheetjs.com https://unpkg.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self' https://www.facebook.com; manifest-src 'self'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://*.i.posthog.com https://www.facebook.com https://connect.facebook.net https://0.peerjs.com wss://0.peerjs.com https://*.firebaseio.com wss://*.firebaseio.com; upgrade-insecure-requests"

  # -- Jangan bocorkan versi software --------------------------------------
  Header always unset X-Powered-By
  Header always unset X-AspNet-Version
  Header always unset Server

  # -- Cache ----------------------------------------------------------------
  # index.html harus selalu divalidasi ulang. Nama file bundle JS/CSS mengandung
  # hash, jadi kalau index.html ikut ter-cache browser akan terus memuat bundle lama
  # dan perubahan terbaru seolah belum ter-publish.
  <FilesMatch "^(index\.html|asset-manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

</IfModule>

# ---------------------------------------------------------------------------
# 4. Matikan tanda tangan server di halaman error
# ---------------------------------------------------------------------------
# Kalau hosting menolak direktif ini (error 500), cukup hapus baris di bawah.
ServerSignature Off
