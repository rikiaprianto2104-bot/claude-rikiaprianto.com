# Alamat Google Apps Script (spreadsheet invoice & sisa kursi).
# Alamat ini ikut terbaca di berkas JavaScript situs dan itu tidak masalah:
# jalur bacanya hanya mengembalikan angka kursi, tanpa data pribadi.
#
# KUNCI RAHASIANYA JANGAN PERNAH DITARUH DI SINI. Variabel REACT_APP_* ikut
# tertanam di berkas yang diunduh pengunjung. Kuncinya diketik sekali di
# halaman /buat-invoice dan tersimpan di peramban pengelola saja.
REACT_APP_KURSI_API=https://script.google.com/macros/s/AKfycbyMJHHmAmGE3QEoz4Sc2dEVE3_M8BHSoOok9zeXK3uB_A-6bUeFSjyK58DZGBTWsbED/exec

# ============================================================================
#  PERINGATAN KEAMANAN
#  Semua variabel REACT_APP_* di file ini DISISIPKAN KE BUNDLE JAVASCRIPT saat
#  build, jadi siapa pun bisa membacanya dari browser (View Source / DevTools).
#  File ini sengaja di-commit karena isinya memang nilai publik.
#  JANGAN PERNAH menaruh rahasia di sini: API key, token, password, secret
#  database. Rahasia hanya boleh hidup di backend/.env (tidak di-commit) atau
#  di GitHub Actions Secrets.
# ============================================================================

# Meta Pixel ID — dipakai di public/index.html (base code + tag <noscript>).
# Ganti nilainya kalau situs ini memakai pixel/akun iklan lain.
REACT_APP_META_PIXEL_ID=1378024890980673

REACT_APP_BACKEND_URL=https://auth-removal-deploy.preview.emergentagent.com
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false