# Salin berkas ini menjadi ".env" (hapus ".contoh"), lalu isi.
# JANGAN pernah membagikan berkas .env, menempelkannya di chat, atau mengunggahnya ke mana pun.

# Token pengguna sistem (Bab 11). Cukup satu baris.
META_TOKEN=ISI_TOKEN_DI_SINI

# Versi Marketing API. Ganti bila Meta menghentikan versi ini (lihat dokumentasi resmi).
META_API_VERSION=v23.0
