# Salin file ini jadi backend/.env lalu isi nilainya.
# backend/.env TIDAK di-commit (lihat .gitignore) karena MONGO_URL akan berisi
# username/password database begitu pindah dari localhost ke server sungguhan.

# Koneksi MongoDB. Di produksi gunakan user khusus dengan hak minimum
# (readWrite hanya pada DB ini), BUKAN user admin.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# production | development
# production = /docs & /openapi.json ditutup, CORS wildcard ditolak,
#              detail error tidak dikirim ke klien.
ENVIRONMENT="development"

# WAJIB diisi eksplisit saat ENVIRONMENT=production. Jangan pernah "*".
CORS_ORIGINS="http://localhost:3000"

# Host yang boleh dipakai di header Host. Kosongkan untuk menonaktifkan.
ALLOWED_HOSTS=""

# Rate limit per IP untuk semua endpoint /api.
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_SECONDS="60"
